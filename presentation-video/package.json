{
  "name": "welvar-taste-craft-video",
  "version": "1.0.0",
  "description": "Kinematic product presentation video for Welvar Taste Craft in light theme",
  "scripts": {
    "start": "remotion preview src/index.ts",
    "build": "tsc --noEmit",
    "render": "remotion render src/index.ts PromoVideo out/promo.mp4 --codec=h264",
    "render:still": "remotion still src/index.ts PromoVideo out/snapshot.png --frame=200"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.218",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.218"
  },
  "devDependencies": {
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "typescript": "^5.5.4"
  }
}
